# ============================================================
# 本机开发环境配置（拷贝为 env.conf 后修改）
# 此文件含本机路径/选择，加入 .gitignore，不要提交。
# 差异性（本机 STM32Cube 包存放位置、工具链前缀板等）集中在此。
# ============================================================

# ----------- STM32Cube 固件包路径（本机绝对路径，按需修改）------------
CUBE_F1_DIR="/where/stm32/lib/STM32CubeF1"
CUBE_F4_DIR="/where/lib/STM32CubeF4"

# ----------- 工具链前缀（opt/homebrew 安装 ARM GCC 后通常为 arm-none-eabi-）------
TOOLCHAIN_PREFIX="arm-none-eabi-"

# ----------- 板子选择（填板子 ID，对应 cmake/boards/ 下已有的 .cmake 文件）-----------
BOARD="stm32f103c8t6"
# BOARD="stm32f407vgtx"

# ----------- 板子特定可选参数（按需取消注释）-----------------
# 系统时钟频率（Hz），默认 8MHz（HSI 内部晶振）。如接外部晶振改为对应频率，如 "16000000U"
# SYS_CLK_FREQ="8000000U"

# F4 开发板支持 SD 卡槽，多数工程需用下面一项自定义容量（如 "32G"、"128G"）
# SD_SIZE="32G"
